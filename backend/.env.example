# --- LIVE DEPLOYMENT URLS ---
# Frontend (Vercel): https://context-iq-frontend-seven.vercel.app/
# Backend (Render): https://contextiq-backend-fbkq.onrender.com

GOOGLE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GROQ_API_KEY=

# LLM Provider. Valid values: "gemini" or "groq"
LLM_PROVIDER=groq

# Embeddings Provider. Valid values: "huggingface" or "google"
# (Use "google" on Render to save memory, "huggingface" runs locally)
EMBEDDING_PROVIDER=google

# Text Chunking Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Retrieval strategy for RAG. 
# Valid values: "metadata_chunk" or "parent_document"
RETRIEVAL_STRATEGY=metadata_chunk
